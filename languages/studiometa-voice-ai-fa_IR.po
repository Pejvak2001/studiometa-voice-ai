msgstr "StudioMeta Voice AI"

#: views/admin-page.php:123
msgid "Manage your voice and chat AI widget."
msgstr "ویجت صوتی و چت هوش مصنوعی خود را مدیریت کنید."

#: views/admin-page.php:1231
msgid "Agent Tools"
msgstr "ابزارهای دستیار"

#: views/admin-page.php:1232
msgid "Define what actions your agent can perform. Each tool triggers your webhook with the tool name and collected parameters."
msgstr "تعیین کنید دستیار شما چه کارهایی می‌تواند انجام دهد. هر ابزار، وب‌هوک شما را با نام ابزار و پارامترهای جمع‌آوری‌شده فراخوانی می‌کند."

#: views/admin-page.php:1236
msgid "No tools defined yet. Add a tool below."
msgstr "هنوز ابزاری تعریف نشده است. از پایین یک ابزار اضافه کنید."

#: views/admin-page.php:1243
msgid "Edit"
msgstr "ویرایش"

#: views/admin-page.php:1254
msgid "Add Tool +"
msgstr "افزودن ابزار +"

#: views/admin-page.php:1260
msgid "Add Tool"
msgstr "افزودن ابزار"

#: views/admin-page.php:1262
msgid "Tool Name"
msgstr "نام ابزار"

#: views/admin-page.php:1262
msgid "lowercase, no spaces"
msgstr "با حروف کوچک، بدون فاصله"

#: views/admin-page.php:1263
msgid "e.g. book_appointment"
msgstr "مثلاً book_appointment"

#: views/admin-page.php:1266
msgid "Description"
msgstr "توضیحات"

#: views/admin-page.php:1266
msgid "tell the agent when to use this tool"
