#: views/admin-page.php:114
msgid "Widget Experience"
msgstr "تجربه ویجت"

#: views/admin-page.php:114
msgid "Customize the floating widget, display behavior, and performance options."
msgstr "ویجت شناور، رفتار نمایش و گزینه‌های کارایی را سفارشی کنید."

#: views/admin-page.php:1151
#: views/admin-page.php:1163
