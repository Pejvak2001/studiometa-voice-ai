#: views/admin-page.php:1270
msgid "Thinking Message"
msgstr "پیام حین پردازش"

#: views/admin-page.php:1270
msgid "shown while processing"
msgstr "هنگام پردازش نمایش داده می‌شود"

#: views/admin-page.php:1271
msgid "Let me check availability..."
